# 複製為 .env 後修改，make 會自動載入並覆寫 Makefile 的預設值。
# 命令列參數（例如 make serve PORT=8080）的優先權仍高於 .env。

# 量化版本：Q4_0 | Q4_K_M | Q5_K_M | Q6_K | Q8_0
# QUANT = Q8_0

# 文字編碼器：gguf（預設）| bf16 | int8（sd.cpp 目前無法載入）
# TE = gguf

# TE=gguf 時的量化版本：Q4_K_M | Q8_0 | F16
# TE_QUANT = Q8_0

# sd-server 監聽位址與連接埠（設為 0.0.0.0 開放區域網路連線）
# HOST = 127.0.0.1
# PORT = 1234

# OpenAI 請求未指定時的預設生成參數
# WIDTH = 1024
# HEIGHT = 1024
# STEPS = 20
# CFG = 1.0
# SAMPLER = euler
# SEED = -1

# 其他 sd-server 參數，例如顯示卡記憶體不足時加上 --offload-to-cpu
# SERVER_ARGS = --diffusion-fa --offload-to-cpu

# Linux 預先編譯版本：auto | cpu | vulkan | rocm
# SDCPP_VARIANT = vulkan
